# ==============================================================================
# Desktop Voice-Controlled Assistant Configuration
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-3.8-flash (fast, balanced, production-ready)
# Alternatives: gemini-3.5-flash-lite, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Assistant Identity & Voice Settings
# ------------------------------------------------------------------------------
# Assistant's display and spoken name
ASSISTANT_NAME=Astra

# Wake words to trigger the assistant (comma-separated). Leave empty to respond to all input.
# Examples: astra, hey astra, jarvis, assistant
WAKE_WORDS=astra,hey astra

# Speech rate in words per minute (typical range: 150 - 220)
SPEECH_RATE=180

# Speech volume level (0.0 to 1.0)
SPEECH_VOLUME=0.9

# Voice Selection:
# 0 = Microsoft David Desktop (Male)
# 1 = Microsoft Zira Desktop (Female)
# Or leave empty to auto-select default
VOICE_INDEX=1

# ------------------------------------------------------------------------------
# Microphone & Recognition Settings
# ------------------------------------------------------------------------------
# Specific microphone device index (leave blank to use system default)
# Run `python main.py --list-microphones` to view your device indices.
MICROPHONE_INDEX=

# Ambient noise calibration duration in seconds on startup
AMBIENT_ADJUST_DURATION=1.0

# Minimum audio energy threshold for microphone detection (0 for auto)
ENERGY_THRESHOLD=300

# Pause threshold in seconds (silence before recognizing speech is finished)
PAUSE_THRESHOLD=0.8

# Maximum phrase recording time limit in seconds
PHRASE_TIME_LIMIT=10

# ------------------------------------------------------------------------------
# Storage Paths
# ------------------------------------------------------------------------------
NOTES_DIR=data/notes
